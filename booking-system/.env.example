NODE_ENV=development
PORT=4000
RELEASE_VERSION=local
BUILD_COMMIT=
BUILD_TIME=
MONGODB_URL=mongodb://127.0.0.1:27017/booking_api_dev
MONGODB_DB_NAME=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_DEV_FALLBACK_MEMORY=false
QA_SEED_DATA=false
APP_BASE_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=Europe/Helsinki
BUSINESS_OWNER_EMAIL=owner@example.com
BUSINESS_SETTINGS_CACHE_TTL_MS=10000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Booking Notifications <no-reply@example.com>"
REVIEW_URL=
ALERTING_ENABLED=true
ALERT_EMAIL_TO=owner@example.com
ALERT_CHECK_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=1800000
ALERT_LOOKBACK_MINUTES=15
AUTOMATED_EMAILS_ENABLED=true
API_BACKGROUND_WORKERS_ENABLED=true
EMAIL_JOB_WORKER_ENABLED=true
RELIABILITY_CLEANUP_ENABLED=true
RELIABILITY_CLEANUP_INTERVAL_MS=300000
RELIABILITY_CLEANUP_BATCH_SIZE=100
TRUST_PROXY=false
REQUEST_LOG_SUCCESS_SAMPLE_RATE=0.05
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_VERSION=1
MONITOR_PASSWORD_HASH=replace-with-different-bcrypt-hash
MONITOR_SESSION_SECRET=replace-with-different-32-random-characters
MONITOR_SESSION_VERSION=1
MONITOR_MFA_ENABLED=true
MONITOR_MFA_CODE_TTL_MINUTES=10
MONITOR_MFA_MAX_ATTEMPTS=5
