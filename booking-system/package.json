{
  "name": "booking-api-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:worker": "tsx watch server/src/worker.ts",
    "mailpit": ".\\tools\\mailpit\\mailpit.exe --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start": "node dist/server/index.js",
    "worker": "node dist/server/worker.js",
    "seed:qa": "tsx tools/seed-qa-data.ts",
    "verify:release": "npm run build && npm run test:smoke && npm run test:api",
    "test:api": "vitest run --root . tests/api.test.ts",
    "test:smoke": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/luxon": "^3.7.1",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.2",
    "nodemailer": "^9.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.2.0",
    "postcss": "^8.4.49",
    "sass": "^1.83.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.8"
  }
}
